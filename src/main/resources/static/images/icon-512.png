<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0d0d1a"/>
      <stop offset="100%" style="stop-color:#12122a"/>
    </linearGradient>
    <linearGradient id="icon" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6c63ff"/>
      <stop offset="100%" style="stop-color:#a29bfe"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#6c63ff;stop-opacity:0.35"/>
      <stop offset="100%" style="stop-color:#6c63ff;stop-opacity:0"/>
    </radialGradient>
  </defs>
  <!-- Background -->
  <rect width="512" height="512" rx="96" fill="url(#bg)"/>
  <!-- Glow -->
  <ellipse cx="256" cy="256" rx="190" ry="190" fill="url(#glow)"/>
  <!-- Shopping bag -->
  <path d="M155 210 L172 375 L340 375 L357 210 Z" fill="url(#icon)" opacity="0.92"/>
  <!-- Bag handle -->
  <path d="M196 210 Q196 148 256 148 Q316 148 316 210" fill="none" stroke="url(#icon)" stroke-width="22" stroke-linecap="round"/>
  <!-- Shine -->
  <path d="M168 228 L172 360 L198 360 L194 228 Z" fill="white" opacity="0.1"/>
  <!-- PWA badge -->
  <rect x="178" y="400" width="156" height="44" rx="22" fill="url(#icon)" opacity="0.7"/>
  <text x="256" y="428" text-anchor="middle" fill="white" font-size="22" font-family="sans-serif" font-weight="bold">PWA</text>
</svg>
